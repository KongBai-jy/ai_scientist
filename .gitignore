# ============================================================
# AI Scientist — Git 忽略规则
# ============================================================

# --- Python 编译缓存 ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg

# --- Python 打包产物 ---
*.egg-info/
*.egg
dist/
build/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.whl

# --- 虚拟环境 ---
.venv/
venv/
env/
ENV/
.env/

# --- 环境变量 / 密钥 ---
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging

# --- 向量数据库（Chroma）持久化数据 ---
data/chroma_db/
data/*.sqlite3
data/*.duckdb

# --- SQLite 数据库（业务库 + 临时库 + WAL/SHM 文件）---
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
data/*.db
data/*.db-journal

# --- 日志文件 ---
*.log
logs/
log/

# --- 输出 / 临时文件 ---
outputs/*
!outputs/.gitkeep
!outputs/init
tmp/
temp/
.cache/

# --- 运行时快照（agent_orchestrator 写出的 V1/V2/V3 等）---
src/snapshots/*.json
!src/snapshots/.gitkeep
snapshots/

# --- API 调试 / 临时响应文件 ---
_api_run_response.json
_api_*_response.json
*.response.json

# --- 测试 / 覆盖率 ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# --- Python 静态检查 / 类型工具缓存 ---
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.dmypy.json
dmypy.json

# --- Jupyter / IPython 运行时 ---
.ipynb_checkpoints
.ipynb_checkpoints/
.profile_default/
ipython_config.py

# --- IDE / 编辑器 ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9settings/
.ultralisp/

# --- 操作系统 ---
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# --- Node.js（前端可能用到）---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Docker ---
docker-compose.override.yml

# --- AI/ML 模型文件 ---
*.pt
*.pth
*.safetensors
*.bin
*.onnx
*.ckpt
*.h5
*.pkl
*.joblib

# --- 大文件 / 数据集 ---
data/raw/
data/datasets/
*.zip
*.tar.gz
*.tar
*.rar
*.7z

# --- 进程 / 锁文件（运行时生成）---
*.pid
*.pid.lock
celerybeat-schedule
celerybeat-schedule.db
celeryevdump.*

# --- LangGraph / LangChain 运行时缓存 ---
.langgraph/
langgraph_cache/
*.langgraph

# --- Windows / Python 工具临时文件 ---
*.bak
*.tmp
*.temp
*.orig
*.rej

# --- Trae / AI 工具本地缓存（如适用）---
.trae/
.aider*

# --- 前端构建产物（如未来引入 web 构建）---
web/dist/
web/build/
web/.vite/
web/.turbo/
web/.next/
web/.nuxt/
web/.output/
web/stats.html

# --- Tailwind / PostCSS 等前端缓存 ---
web/.cache/
web/node_modules/.cache/

# --- Storybook / 测试快照（前端）---
web/storybook-static/
web/__snapshots__/*.snap

# --- 数据版本控制（DVC，如启用）---
.dvc/cache/
.dvc/tmp/
*.dvc.lock