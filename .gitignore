# ============================================================
# AI Scientist — Git 忽略规则
# ============================================================

# --- Python 编译缓存 ---
__pycache__/
*.py[cod]
*$py.class

# --- Python 打包产物（保留最常用）---
*.egg
*.egg-info/
dist/
build/

# --- 虚拟环境 ---
.venv/
venv/
env/
ENV/
.env/

# --- 环境变量 / 密钥 ---
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging

# --- 向量数据库（Chroma）持久化数据 ---
data/chroma_db_backup_v1/
data/*.duckdb
#  本地 1715 条知识库 sqlite3（≈17.9 MB），避免个人增量修改被误提交/推送到远端。
#  全局 *.sqlite3 规则本已覆盖，这里显式声明以防未来全局规则调整失效。
data/chroma_db/chroma.sqlite3

# --- SQLite 数据库及 WAL/SHM 文件（全局 + data 下双层覆盖）---
*.db
*.db-journal
*.sqlite
*.sqlite3
!data/chroma_db/chroma.sqlite3
*.sqlite-shm
*.sqlite-wal
data/ai_scientist.db
data/ai_scientist.db-wal
data/ai_scientist.db-shm

# --- 日志文件 ---
*.log
logs/
log/

# --- 输出 / 临时文件 ---
outputs/*
!outputs/.gitkeep
!outputs/init
tmp/
temp/
.cache/

# --- 运行时快照（agent_orchestrator 写出的 V1/V2/V3 JSON）---
snapshots/

# --- API 调试 / 临时响应文件 ---
_api_run_response.json
_api_*_response.json
*.response.json

# --- 测试 / 静态检查缓存 ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# --- IDE / 编辑器 ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# --- 操作系统常见垃圾文件 ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Windows / 通用临时文件 ---
*.bak
*.tmp
*.temp

# --- 更多文件 ---
.trae/
report
