
############# 配置 DashScope API 密钥和基础 URL #############

# === 主聊天模型（用于 Explorer / Critic / Orchestrator）===
# 必须选用支持「结构化输出 Structured Outputs」的模型，3 个 Agent 都用 with_structured_output() 强制 JSON
# 可选值: qwen-plus(推荐,平衡) / qwen-max(最强) / qwen-turbo(最快) / qwen-flash(Qwen3,1M上下文)
QWEN_MODEL=qwen-plus

# === Scientist 专用模型（可选）===
# 若填写则 Scientist Agent 使用此模型，其余 Agent 仍用上方 QWEN_MODEL；留空则统一使用 QWEN_MODEL
# 建议用最强模型：Scientist 负责生成假设和研究计划，是 pipeline 中最吃模型能力的环节
#QWEN_MODEL_SCIENTIST=qwen-max

# DashScope API 配置（必填）
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# === Embedding 模型（用于 Chroma 向量库）===
#   text-embedding-v3=1024维  text-embedding-v4=1024维  qwen3.7-text-embedding=1024维
QWEN_MODEL_EMBEDDING=qwen3.7-text-embedding
# 留空则自动复用上方主 API Key
DASHSCOPE_API_KEY_EMBEDDING=
DASHSCOPE_API_BASE_EMBEDDING=https://dashscope.aliyuncs.com/compatible-mode/v1

# === 视觉模型（用于多模态图片理解）===
# 可选值: qwen-vl-max(最强) / qwen-vl-plus(平衡) / qwen-vl-ocr(文字识别)
# 若留空则自动复用上方主聊天模型的 API Key
QWEN_VL_MODEL=qwen-vl-max
DASHSCOPE_API_KEY_VL=
DASHSCOPE_API_BASE_VL=https://dashscope.aliyuncs.com/compatible-mode/v1


# ── 存储路径（目录不存在时程序会自动创建）──
SNAPSHOTS_PATH=./snapshots
CHROMA_DB_PATH=./data/chroma_db
KNOWLEDGE_BASE_PATH=./knowledge_base

# ── 数据库（默认 SQLite；注释掉 DATABASE_URL 并填写下方 MYSQL_* 即可切到 MySQL）──
DATABASE_URL=sqlite:///./data/ai_scientist.db

# 迭代次数上限
MAX_ITERATIONS=3

# ── MySQL（按需填写；当 DATABASE_URL 被注释或删除时自动生效）──
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=agent_snapshot_db

# ── Chroma 向量库持久化 ──
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=ai_scientist_literature

# ── FastAPI 服务 ─
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=True

# ── 安全 ──
SECRET_KEY=change-me-to-a-random-secret-string
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── 可选：LangSmith 追踪（留空关闭）──
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai_scientist

# ── OpenAlex 离线采集礼貌池邮箱（可选）──
# 填入你的邮箱可进入 OpenAlex polite pool（更高 QPS、更稳定）；留空则脚本不带 mailto 参数（默认约 1 req/s）
# 仅供 scripts/collect_openalex.py 使用，不会用于其他用途
OPENALEX_EMAIL=

# ── 在线检索文献保留开关 ──
# true：在线检索（arXiv）入库的临时文献跑完 pipeline 后保留在向量库，不再清理（用于 125 题全量输出，长期复用证据）
# false（默认）：按策略 B 精确清理本次塞入的临时文献，避免污染长期知识库
KEEP_SEARCHED_PAPERS=false
